COMPOSE_PROJECT_NAME=followw-preview
CADDYFILE=./Caddyfile.preview
PUBLIC_URL=https://oracle.followw.app/api
CORS_ORIGINS='["https://oracle.followw.app"]'

# Gere uma senha hexadecimal diferente para cada conta com openssl rand -hex 32.
POSTGRES_PASSWORD=
