{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "ignorePatterns": [
        "**.gen.ts",
        "schema.gen.ts",
        "**/components/ui/**",
        "**/uniwind-types.d.ts"
    ],
    "plugins": ["typescript", "react", "import", "unicorn", "oxc", "jsx-a11y", "promise"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn",
        "perf": "warn"
    },
    "jsPlugins": ["./apps/web/lint/followw-plugin.ts"],
    "options": {
        "typeAware": true,
        "reportUnusedDisableDirectives": "warn"
    },
    "env": {
        "browser": true,
        "es2024": true,
        "node": true
    },
    "rules": {
        "react/react-in-jsx-scope": "off",
        "jsx-a11y/anchor-is-valid": "off",
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        "typescript/no-deprecated": "error",
        "followw/no-classname-concat": "error",
        "followw/no-hardcoded-email": "error",
        "no-restricted-globals": [
            "error",
            {
                "name": "fetch",
                "message": "Use o client de src/queries."
            }
        ],
        "no-restricted-imports": [
            "error",
            {
                "paths": [
                    {
                        "name": "react",
                        "importNames": ["default"],
                        "message": "O namespace React é global; use React.* sem importar."
                    },
                    {
                        "name": "@tanstack/react-router",
                        "importNames": ["useSearch"],
                        "message": "Leia a URL com nuqs (useQueryStates)."
                    }
                ]
            }
        ]
    },
    "overrides": [
        {
            "files": ["apps/web/src/queries/**", "packages/core/src/queries/**"],
            "rules": {
                "no-restricted-globals": "off"
            }
        },
        {
            "files": ["apps/web/src/lib/contact.ts", "apps/web/tests/**"],
            "rules": {
                "followw/no-hardcoded-email": "off"
            }
        },
        {
            "files": ["apps/mobile/**"],
            "rules": {
                "jsx-a11y/prefer-tag-over-role": "off",
                "react/style-prop-object": "off",
                "import/no-unassigned-import": [
                    "warn",
                    {
                        "allow": ["**/*.css"]
                    }
                ]
            }
        },
        {
            "files": ["apps/mobile/tests/**"],
            "rules": {
                "typescript/no-unsafe-type-assertion": "off"
            }
        }
    ]
}
