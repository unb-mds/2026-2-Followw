ENVIRONMENT=development # "development" | "production"
CORS_ORIGINS=["https://followw.app"] # o front usa /api da mesma origem; só outros clientes precisam
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/followw
JWT_SECRET_KEY= # openssl rand -base64 32

# Jobs do sync: o QStash entrega em PUBLIC_URL/jobs (no compose, a API do host).
PUBLIC_URL=http://host.docker.internal:8000

QSTASH_URL=http://localhost:8080
QSTASH_TOKEN=eyJVc2VySUQiOiJkZWZhdWx0VXNlciIsIlBhc3N3b3JkIjoiZGVmYXVsdFBhc3N3b3JkIn0=
QSTASH_CURRENT_SIGNING_KEY=sig_7kYjw48mhY7kAjqNGcy6cr29RJ6r
QSTASH_NEXT_SIGNING_KEY=sig_5ZB6DVzB1wjE8S6rZ7eenA8Pdnhs

UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=followw
REDIS_TIMEOUT_SECONDS=1 # tempo máximo de espera; falhas liberam a requisição

# Rate limit por IP em janela fixa (segundos); POST /auth/sigaa tem cota própria.
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_LOGIN_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SECRET_KEY= # openssl rand -base64 32; mesmo valor no servidor web (SSR) e na API

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# Credenciais para testar a área autenticada
TEST_REGISTRATION=
TEST_PASSWORD=
