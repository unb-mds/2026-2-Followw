ENVIRONMENT=development # "development" | "production"
CORS_ORIGINS=["https://followw.app"] # em desenvolvimento, localhost:3000 é incluído automaticamente
COOKIE_DOMAIN= # em produção: followw.app
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/followw
JWT_SECRET_KEY= # openssl rand -base64 32

# Jobs do sync: o QStash entrega em PUBLIC_URL/jobs.
PUBLIC_URL=http://localhost:8000

QSTASH_URL=http://localhost:8080
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
