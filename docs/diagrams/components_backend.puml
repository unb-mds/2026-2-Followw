@startuml components_backend
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Componentes — Backend API (apps/api)

Container_Boundary(api_boundary, "FastAPI Application") {
    Component(modules, "Módulos por feature", "Router, Service e Repository", "auth, classrooms, me, posts, public_classrooms, public_courses, public_restaurant, public_subjects")
    Component(session, "Sessão e cookies", "JWE / HKDF", "Criptografa e decifra a sessão em cookies HttpOnly (AES-256-GCM)")
    Component(sync, "Sync & Calendário", "Stale-While-Revalidate", "Resolve o cache, congela semestres encerrados e junta o que venceu em um job por turma")
    Component(jobs, "Rota /jobs", "QStash + Fernet", "Valida assinatura, decifra credencial, loga numa sessão própria do SIGAA, roda tarefas e faz logout")
    Component(logger, "Observabilidade", "RequestLoggingMiddleware", "Emite logs estruturados JSON por evento com request_id e duration_ms sem dados sensíveis")
}

Component_Ext(sigaa_client, "sigaa-client", "Python Package", "Abstração do SIGAA com suporte a ViewState/JSF, PDFs e QR Code (zxing-cpp)")
Component_Ext(unb_browser, "unb-browser", "Python Package", "Scraper do RU e calendários com extração geométrica via pdfplumber")

ContainerDb(db, "PostgreSQL 18+", "Banco de dados relacional")
System_Ext(qstash, "Upstash QStash", "Fila de jobs")
System_Ext(sigaa, "SIGAA / CAS", "Servidor UnB")
System_Ext(ru_site, "Site do RU", "PDFs públicos")

Rel(modules, session, "Valida e renova a sessão do usuário")
Rel(modules, sync, "Resolve dados com cache")
Rel(modules, logger, "Registra métricas e eventos da requisição")
Rel(sync, db, "Consulta / grava cache")
Rel(sync, qstash, "Publica jobs com a credencial cifrada")
Rel(qstash, jobs, "Entrega os jobs")
Rel(jobs, sync, "Roda as tarefas das features")
Rel(sync, sigaa_client, "Solicita dados do SIGAA")
Rel(modules, unb_browser, "Solicita cardápio do RU e calendários")
Rel(sigaa_client, sigaa, "Chamadas HTTP/JSF")
Rel(unb_browser, ru_site, "Download e parse de PDF")

@enduml
